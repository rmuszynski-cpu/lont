# Buduje aplikację Lont na Androida i wystawia plik Lont.apk w zakładce "Releases".
# Uruchamia się samo po każdej zmianie plików, a ręcznie: zakładka Actions -> "Zbuduj APK" -> Run workflow.
name: Zbuduj APK

on:
  push:
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: apk
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Pobierz pliki
        uses: actions/checkout@v4

      - name: Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Zaakceptuj licencje Androida
        run: yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true

      - name: Zbuduj APK
        run: gradle -p android assembleDebug --no-daemon --stacktrace

      - name: Nazwij plik Lont.apk
        run: cp android/app/build/outputs/apk/debug/app-debug.apk Lont.apk

      - name: Zachowaj APK jako plik do pobrania z przebiegu
        uses: actions/upload-artifact@v4
        with:
          name: Lont-apk
          path: Lont.apk

      - name: Opublikuj APK w zakładce Releases
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release delete apk-latest --cleanup-tag --yes || true
          gh release create apk-latest Lont.apk \
            --target "$GITHUB_SHA" \
            --title "Lont – najnowsza wersja na Androida" \
            --notes "Pobierz plik Lont.apk na telefon z Androidem i otwórz go. Zbudowano automatycznie z commita ${GITHUB_SHA::7}." \
            --latest
            
